# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# Local:   mongodb://localhost:27017/demosourcing
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/demosourcing
MONGO_URI=mongodb://localhost:27017/demosourcing

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────────
# Max file size in bytes (default: 10 MB)
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_DIR=uploads

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://demosourcing.atenxion.ai

# ─── Email (Nodemailer / SMTP) ──────────────────────────────
# Required for vendor/company notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=DemoSourcing <noreply@yourdomain.com>

# ─── Admin Seed (optional) ────────────────────────────────
# Used by db:seed script to create the initial admin account
SEED_ADMIN_EMAIL=admin@atenxion.ai
SEED_ADMIN_PASSWORD=ChangeMe@123
